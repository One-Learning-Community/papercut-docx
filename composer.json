{
    "name": "papercut/docx",
    "description": "Word (.docx) export for Papercut documents.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/One-Learning-Community/papercut",
    "support": {
        "issues": "https://github.com/One-Learning-Community/papercut/issues",
        "source": "https://github.com/One-Learning-Community/papercut",
        "docs": "https://one-learning-community.github.io/papercut/guide/word-export.html"
    },
    "authors": [
        {
            "name": "One Learning Community",
            "role": "Maintainer"
        }
    ],
    "keywords": [
        "docx",
        "word",
        "export",
        "document",
        "papercut"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true,
                "versions": {
                    "papercut/core": "0.5.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-zip": "*",
        "dskripchenko/php-docx": "^1.18",
        "papercut/core": "^0.5"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.1",
        "phiki/phiki": "^2.2",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-gd": "Pictures in Word: WebP and AVIF images, image cover and opacity, and plain QR codes",
        "ext-imagick": "Styled QR codes and SVG in Word (SVG needs an Imagick build that reads SVG)",
        "bacon/bacon-qr-code": "Styled QR codes (with ext-imagick)"
    },
    "autoload": {
        "psr-4": {
            "Papercut\\Docx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Papercut\\Docx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
